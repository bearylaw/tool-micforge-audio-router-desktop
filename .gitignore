# --- secrets / user state -------------------------------------------------
# MicForge stores the Discord client secret and OAuth tokens in its config.
# It normally lives in %APPDATA%\MicForge (or ~/.config/micforge), but if
# MICFORGE_HOME is pointed at the checkout, keep it out of git regardless.
config.json
config.*.json
*.broken.json
tokens.json
secrets.*
.env
.env.*
!.env.example

# --- user content ---------------------------------------------------------
# Sound files a user drops in are theirs, not part of the project.
assets/sounds/*
!assets/sounds/.gitkeep
presets/
*.mp3
*.wav
*.ogg
*.flac
*.m4a
*.opus

# --- python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
.Python
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# --- tooling / test caches ------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# --- logs -----------------------------------------------------------------
*.log
logs/

# --- packaging ------------------------------------------------------------
*.spec.bak
release/

# --- editors / OS ---------------------------------------------------------
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
